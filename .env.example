# {Documented Supabase, Cloudflare R2, and AI service environment variables} [Commented by: Sonic on 10/14/2026 10:35 AM]

# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
# In Supabase: Project Settings -> API -> Project URL
# In Netlify: Automatically injected if using Netlify's official Supabase integration extension.
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase Anon/Public Key (e.g. eyJhbGciOi...)
# In Supabase: Project Settings -> API -> Project API Keys -> anon / public
# In Netlify: Automatically injected if using Netlify's official Supabase integration extension.
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Optional Cloudflare R2 Tiered Storage (for archiving older conversations > 10 messages)
VITE_R2_ACCOUNT_ID=""
VITE_R2_BUCKET_NAME=""
VITE_R2_ACCESS_KEY_ID=""
VITE_R2_SECRET_ACCESS_KEY=""
VITE_R2_PUBLIC_URL=""

# Optional global fallback keys (users configure their own in Sign Up / Settings)
VITE_OPENROUTER_API_KEY=""
VITE_TAVILY_API_KEY=""

# {Documented Cloudflare Worker chat history persistence endpoint} [Commented by: Google AI Studio on October 14, 2026 at 10:55 AM]
# Cloudflare Worker API URL for persistent chat history and D1 database operations
VITE_CLOUDFLARE_WORKER_URL="https://nanobot-api.mud-amiable-tweed.workers.dev"
